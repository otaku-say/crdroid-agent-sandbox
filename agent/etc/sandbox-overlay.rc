# 由 sandbox-install-boot-hook.sh 注入 boot.img 的 overlay.d，勿手改。
# 只负责把 sandbox-post-fs-data.sh 挂到 post-fs-data 阶段；
# 运行期的一切收敛由 /data/adb/service.d/sandbox-boot-converge.sh 负责。

on post-fs-data
    start sandbox_post_fs_data

service sandbox_post_fs_data ${MAGISKTMP}/sandbox-post-fs-data.sh
    user root
    seclabel u:r:magisk:s0
    oneshot

# 首次开机（Format Data 后）的收敛补偿：
# service.d 是 post-fs-data 才恢复的，magiskd 已扫描过，不会自动执行。
on late-init
    start sandbox_converge_guard

# 脚本放 ramdisk：late-init 触发时 /cache 与 /data 都还没挂载（status 127 就是这样来的）
service sandbox_converge_guard /system/bin/sh ${MAGISKTMP}/converge-guard.sh
    user root
    seclabel u:r:magisk:s0
    oneshot

# ---------------------------------------------------------------------------
# 单进程常驻守护（见 lib/sandbox-guardian.sh）。
# 不走多个 service 的原因：init 对 ${MAGISKTMP} 多参数形式的 service 解析失败，
# 且从脚本 fork 的进程会被 process-group kill 带走。
# ---------------------------------------------------------------------------
on late-init
    start sandbox_guardian

service sandbox_guardian /system/bin/sh ${MAGISKTMP}/sandbox-guardian.sh
    user root
    seclabel u:r:magisk:s0
